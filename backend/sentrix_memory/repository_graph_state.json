      "file_path": "app.py",
      "language": "python",
      "source_code": "from cart_service import CartService\nfrom auth import AuthService\n\ncart_service = CartService()\nauth_service = AuthService()\n\ndef handle_add_to_cart(user_id, product_id):\n    token = auth_service.verify_token(user_id)\n    cart = cart_service.add_to_cart(user_id, product_id)\n    return cart\n\ndef handle_checkout(user_id):\n    cart_service.checkout(user_id)\n"
