    {
      "file_name": "cart_service.py",
      "rel_path": "cart_service.py",
      "file_path": "cart_service.py",
      "language": "python",
      "source_code": "from models import User, Cart, Product\n\nclass CartService:\n    def __init__(self):\n        self.db = None\n\n    def get_user_cart(self, user_id):\n        user = self.db.find_user(user_id)\n        return user.cart\n\n    def add_to_cart(self, user_id, product_id):\n        user = self.db.find_user(user_id)\n        product = self.db.find_product(product_id)\n        if user.cart is None:\n            user.cart = Cart()\n        user.cart.add_item(product)\n        return user.cart\n\n    def checkout(self, user_id):\n        cart = self.get_user_cart(user_id)\n        total = cart.calculate_total()\n        self.db.save_order(user_id, total)\n        user.cart = None\n        return total\n"
    },
    {
      "file_name": "auth.py",
      "rel_path": "auth.py",
      "file_path": "auth.py",
      "language": "python",
      "source_code": "import jwt\n\nclass AuthService:\n    def __init__(self):\n        self.secret = None\n        self.encoder = None\n\n    def login(self, email, password):\n        user = self.db.find_by_email(email)\n        if not user:\n            raise ValueError('User not found')\n        token = self.encoder.encode({'user_id': user.user_id}, self.secret)\n        return token\n\n    def verify_token(self, token):\n        return jwt.decode(token, self.secret, algorithms=['HS256'])\n\n    def logout(self, user_id):\n        self.session_store.remove(user_id)\n"
    },
